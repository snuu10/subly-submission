{
  "expo": {
    "name": "Subly",
    "slug": "subly",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "primaryColor": "#4F46E5",
    "scheme": "subly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.subly.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.subly.app",
      "versionCode": 17,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 180,
          "backgroundColor": "#F9FAFB"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "결제 화면과 영수증을 읽어 구독 정보를 자동으로 채우기 위해 사진에 접근합니다.",
          "cameraPermission": "결제 화면과 영수증을 촬영해 구독 정보를 자동으로 채우기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4F46E5",
          "defaultChannel": "payment-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c46ffeb8-1233-4d27-9065-4fe9021a8309"
      }
    },
    "owner": "product-chany"
  }
}
